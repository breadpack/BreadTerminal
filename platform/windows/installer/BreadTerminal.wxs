<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="BreadTerminal"
           Manufacturer="BreadTerminal Team"
           Version="$(var.ProductVersion)"
           UpgradeCode="E8A1B2C3-D4E5-6F7A-8B9C-0D1E2F3A4B5C">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of BreadTerminal is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BreadTerminal">
        <Directory Id="ShellDir" Name="shell" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D">
        <File Id="BreadTerminalExe" Source="$(var.PackageDir)\BreadTerminal.exe" KeyPath="yes" />
      </Component>
      <!-- bread CLI tool -->
      <Component Id="BreadCli" Guid="D5E6F7A8-B9C0-1D2E-3F4A-5B6C7D8E9F00">
        <File Source="$(var.PackageDir)\bread.exe" KeyPath="yes" />
      </Component>
      <!-- ConPTY binaries (full VT passthrough) -->
      <Component Id="ConPtyBinaries" Guid="E6F7A8B9-C0D1-2E3F-4A5B-6C7D8E9F0011">
        <File Source="$(var.PackageDir)\conpty.dll" />
        <File Source="$(var.PackageDir)\OpenConsole.exe" />
      </Component>
      <!-- Crashpad handler (crash reporting) -->
      <Component Id="CrashHandler" Guid="F7A8B9C0-D1E2-3F4A-5B6C-7D8E9F001122">
        <File Source="$(var.PackageDir)\crashpad_handler.exe" KeyPath="yes" />
      </Component>
      <!-- Resource files (theme/font index) -->
      <Component Id="ResourceFiles" Guid="C9D0E1F2-A3B4-5C6D-7E8F-900112233445">
        <File Source="$(var.PackageDir)\theme_index.json" />
        <File Source="$(var.PackageDir)\font_index.json" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShellScripts" Directory="ShellDir">
      <Component Id="BashIntegration" Guid="C3D4E5F6-A7B8-9C0D-1E2F-3A4B5C6D7E8F">
        <File Source="$(var.PackageDir)\shell\bash-integration.sh" KeyPath="yes" />
      </Component>
      <Component Id="ZshIntegration" Guid="D4E5F6A7-B8C9-0D1E-2F3A-4B5C6D7E8F90">
        <File Source="$(var.PackageDir)\shell\zsh-integration.zsh" KeyPath="yes" />
      </Component>
      <Component Id="FishIntegration" Guid="E5F6A7B8-C9D0-1E2F-3A4B-5C6D7E8F9001">
        <File Source="$(var.PackageDir)\shell\fish-integration.fish" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Add to PATH -->
    <ComponentGroup Id="EnvironmentPath" Directory="INSTALLFOLDER">
      <Component Id="PathEntry" Guid="F6A7B8C9-D0E1-2F3A-4B5C-6D7E8F900112">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="BreadTerminal" />
    </StandardDirectory>

    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="A7B8C9D0-E1F2-3A4B-5C6D-7E8F90011223">
        <Shortcut Id="AppShortcut" Name="BreadTerminal" Target="[INSTALLFOLDER]BreadTerminal.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut" Name="BreadTerminal" Target="[INSTALLFOLDER]BreadTerminal.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Directory="DesktopFolder" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\BreadTerminal" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Windows Terminal profile registration script -->
    <ComponentGroup Id="InstallerScripts" Directory="INSTALLFOLDER">
      <Component Id="WTProfileScript" Guid="B8C9D0E1-F2A3-4B5C-6D7E-8F9001122334">
        <File Id="RegisterWTProfile" Source="$(var.PackageDir)\register-wt-profile.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="DesktopFolder" />

    <Icon Id="AppIcon" SourceFile="$(var.PackageDir)\BreadTerminal.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Feature Id="ProductFeature" Title="BreadTerminal" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShellScripts" />
      <ComponentGroupRef Id="EnvironmentPath" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="InstallerScripts" />
    </Feature>

    <!-- Custom action: register Windows Terminal profile (runs after files installed) -->
    <SetProperty Id="POWERSHELLEXE" Value="[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe"
                 Sequence="execute" Before="RegisterWTProfileAction" />
    <CustomAction Id="RegisterWTProfileAction"
                  Property="POWERSHELLEXE"
                  ExeCommand="-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]register-wt-profile.ps1&quot;"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterWTProfileAction" After="InstallFinalize" Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>

    <!-- Launch after install (checkbox on exit dialog) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch BreadTerminal" />
    <Property Id="WixShellExecTarget" Value="[#BreadTerminalExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- Skip license agreement + wire launch checkbox -->
    <Property Id="LicenseAccepted" Value="1" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog"
               Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT REMOVE" />
    </UI>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
