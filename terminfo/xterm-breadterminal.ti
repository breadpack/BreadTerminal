# BreadTerminal terminfo source
# Based on xterm-256color with BreadTerminal-specific extensions
#
# Compile with: tic -x -o <output_dir> xterm-breadterminal.ti

xterm-breadterminal|BreadTerminal terminal emulator,
# Boolean capabilities
	am,
	bce,
	km,
	mir,
	msgr,
	xenl,
# Numeric capabilities
	colors#256,
	cols#80,
	it#8,
	lines#24,
	pairs#32767,
# Cursor movement
	cup=\E[%i%p1%d;%p2%dH,
	cuu=\E[%p1%dA,
	cud=\E[%p1%dB,
	cuf=\E[%p1%dC,
	cub=\E[%p1%dD,
	home=\E[H,
	cuu1=\E[A,
	cud1=\n,
	cuf1=\E[C,
	cub1=\b,
	cr=\r,
# Erase and clear
	ed=\E[J,
	el=\E[K,
	el1=\E[1K,
	ech=\E[%p1%dX,
	clear=\E[H\E[2J,
# Delete and insert characters
	dch=\E[%p1%dP,
	dch1=\E[P,
	ich=\E[%p1%d@,
# Scroll region and scrolling
	csr=\E[%i%p1%d;%p2%dr,
	indn=\E[%p1%dS,
	rin=\E[%p1%dT,
	ind=\n,
	ri=\EM,
	il=\E[%p1%dL,
	il1=\E[L,
	dl=\E[%p1%dM,
	dl1=\E[M,
# Cursor style (DECSCUSR)
	Ss=\E[%p1%d q,
	Se=\E[2 q,
# Cursor visibility
	civis=\E[?25l,
	cnorm=\E[?12l\E[?25h,
	cvvis=\E[?12;25h,
# Keypad and cursor key modes
	smkx=\E[?1h\E=,
	rmkx=\E[?1l\E>,
# Alternate screen buffer
	smcup=\E[?1049h\E[22;0;0t,
	rmcup=\E[?1049l\E[23;0;0t,
# Auto-margin mode
	smam=\E[?7h,
	rmam=\E[?7l,
# Text attributes (SGR)
	bold=\E[1m,
	dim=\E[2m,
	sitm=\E[3m,
	ritm=\E[23m,
	smul=\E[4m,
	rmul=\E[24m,
	blink=\E[5m,
	rev=\E[7m,
	invis=\E[8m,
	smxx=\E[9m,
	rmxx=\E[29m,
	sgr0=\E[m,
	sgr=\E[0%?%p6%t;1%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;%?%p5%t;2%;m%?%p9%t\016%e\017%;,
	smso=\E[7m,
	rmso=\E[27m,
	smacs=\E(0,
	rmacs=\E(B,
# 256-color support (setaf/setab xterm canonical form)
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	op=\E[39;49m,
# Tab
	ht=\t,
	hts=\EH,
	tbc=\E[3g,
	cbt=\E[Z,
# Bell
	bel=^G,
	flash=\E[?5h$<100/>\E[?5l,
# Function keys (xterm-style)
	kf1=\EOP,
	kf2=\EOQ,
	kf3=\EOR,
	kf4=\EOS,
	kf5=\E[15~,
	kf6=\E[17~,
	kf7=\E[18~,
	kf8=\E[19~,
	kf9=\E[20~,
	kf10=\E[21~,
	kf11=\E[23~,
	kf12=\E[24~,
	kf13=\E[1;2P,
	kf14=\E[1;2Q,
	kf15=\E[1;2R,
	kf16=\E[1;2S,
	kf17=\E[15;2~,
	kf18=\E[17;2~,
	kf19=\E[18;2~,
	kf20=\E[19;2~,
	kf21=\E[20;2~,
	kf22=\E[21;2~,
	kf23=\E[23;2~,
	kf24=\E[24;2~,
# Arrow keys
	kcuu1=\EOA,
	kcud1=\EOB,
	kcuf1=\EOC,
	kcub1=\EOD,
# Navigation keys
	khome=\EOH,
	kend=\EOF,
	kpp=\E[5~,
	knp=\E[6~,
	kich1=\E[2~,
	kdch1=\E[3~,
# Backspace
	kbs=\177,
# Mouse support
	kmous=\E[M,
	XM=\E[?1006;1000%?%p1%{1}%=%th%el%;,
# Bracketed paste
	BE=\E[?2004h,
	BD=\E[?2004l,
	PS=\E[200~,
	PE=\E[201~,
# Extended capabilities (-x)
	Tc,
	RGB,
	Ss=\E[%p1%d q,
	Se=\E[2 q,
	Sync=\E[?2026%?%p1%{1}%=%th%el%;,
	fullkbd,
	Sixel,
